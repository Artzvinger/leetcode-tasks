/**
 * Type: Math / String / Medium
 * [7] Reverse Integer
 *
 * 📌 Условие: Дано 32-битное целое число x. Верните число с перевернутыми цифрами.
 *             Если результат выходит за пределы 32-битного диапазона [-2^31, 2^31 - 1],
 *             верните 0.
 *
 * 🔍 Маркеры: перевернуть цифры, 32-битное, проверка переполнения.
 * 📏 Тип: Математика / строки.
 * 🧠 Идея: Преобразуем число в строку, переворачиваем, преобразуем обратно в число.
 *          Сохраняем знак. Проверяем выход за пределы 32-битного диапазона.
 *
 * ⏱ Сложность: O(n) по времени (n - количество цифр), O(n) по памяти.
 *
 * @param {number} x - 32-битное целое число
 * @return {number} - перевернутое число или 0 при переполнении
 */
var reverse = function(x) {
    let sign;
    if (x < 0) {
        sign = -1;
    } else {
        sign = 1;
    }
    const arr = Math.abs(x).toString().split('').reverse().join('');
    const result = Number(arr) * sign;
    if (result > 2147483647 || result < -2147483648) return 0;
    return result;
};
